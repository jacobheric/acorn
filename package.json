{
  "name": "relay-ci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run check && npm test && npm run build",
    "relay": "tsx --env-file-if-exists=.env cli/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "graphql": "^16.11.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
